# The terminal the Android app emulates (app/src/main/c/vterm.c). ncurses only sends what is
# listed here, so everything here must work there.
toxic-android|terminal of toxic's Android app,
	am, bce, msgr, xenl, AX,
	colors#256, cols#80, it#8, lines#24, pairs#32767, U8#1,
	bel=^G, cr=\r, ht=^I, ind=\n, ri=\EM, nel=\r\n,
	cub1=^H, cud1=\n, cuf1=\E[C, cuu1=\E[A,
	cub=\E[%p1%dD, cud=\E[%p1%dB, cuf=\E[%p1%dC, cuu=\E[%p1%dA,
	cup=\E[%i%p1%d;%p2%dH, home=\E[H, hpa=\E[%i%p1%dG, vpa=\E[%i%p1%dd,
	clear=\E[H\E[2J, ed=\E[J, el=\E[K, ech=\E[%p1%dX,
	csr=\E[%i%p1%d;%p2%dr,
	civis=\E[?25l, cnorm=\E[?25h, rmam=\E[?7l, smam=\E[?7h,
	sgr0=\E[m, bold=\E[1m, dim=\E[2m, sitm=\E[3m, ritm=\E[23m,
	smul=\E[4m, rmul=\E[24m, rev=\E[7m, smso=\E[7m, rmso=\E[27m,
	setaf=\E[%?%p1%{8}%<%t3%p1%d%e%p1%{16}%<%t9%p1%{8}%-%d%e38;5;%p1%d%;m,
	setab=\E[%?%p1%{8}%<%t4%p1%d%e%p1%{16}%<%t10%p1%{8}%-%d%e48;5;%p1%d%;m,
	op=\E[39;49m,
	kbs=^?, kcbt=\E[Z,
	kcub1=\E[D, kcud1=\E[B, kcuf1=\E[C, kcuu1=\E[A,
	kich1=\E[2~, kdch1=\E[3~, khome=\E[H, kend=\E[F, kpp=\E[5~, knp=\E[6~,
	kf1=\EOP, kf2=\EOQ, kf3=\EOR, kf4=\EOS, kf5=\E[15~, kf6=\E[17~,
	kf7=\E[18~, kf8=\E[19~, kf9=\E[20~, kf10=\E[21~, kf11=\E[23~, kf12=\E[24~,
